<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Base Theme ─────────────────────────────────── -->
    <style name="Base.Theme.SoftPower" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorPrimaryDark">@color/teal_primary</item>
        <item name="colorAccent">@color/teal_primary</item>
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@color/teal_primary</item>
    </style>

    <style name="Theme.SoftPower" parent="Base.Theme.SoftPower" />

    <!-- ── Splash Theme ───────────────────────────────── -->
    <style name="Theme.SoftPower.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_power</item>
        <item name="postSplashScreenTheme">@style/Theme.SoftPower</item>
    </style>

</resources>